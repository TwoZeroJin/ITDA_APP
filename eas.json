{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "local",
      "distribution": "internal",
      "env": { "APP_ENV": "local" }
    },
    "preview": {
      "channel": "develop",
      "distribution": "internal",
      "env": { 
        "APP_ENV": "dev",
        "EXPO_NO_DOTENV": "1"
       }
    },
    "production": {
      "channel": "prod",
      "distribution": "store",
      "env": { 
        "APP_ENV": "prod",
        "EXPO_NO_DOTENV": "1"
       },
      "autoIncrement": true
    }
  }
}