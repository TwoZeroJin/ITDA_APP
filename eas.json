{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "distribution": "internal",
      "env": { "APP_ENV": "local" }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": { "APP_ENV": "dev" }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "env": { "APP_ENV": "prod" }
    }
  }
}