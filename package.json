{
  "name": "itda_app",
  "main": "expo-router/entry",
  "version": "1.1.10",
  "scripts": {
    "start:local": "set EXPO_NO_DOTENV=1&& set APP_ENV=local&& expo start --tunnel --clear",
    "start:dev": "set EXPO_NO_DOTENV=1&& set APP_ENV=dev&& expo start --tunnel --clear",
    "start:prod": "set EXPO_NO_DOTENV=1&& set APP_ENV=prod&& expo start --tunnel --clear",
    "update:local": "set EXPO_NO_DOTENV=1&& set APP_ENV=local&& eas update --branch local",
    "update:dev": "set EXPO_NO_DOTENV=1&& set APP_ENV=dev&& eas update --branch develop",
    "update:prod": "set EXPO_NO_DOTENV=1&& set APP_ENV=prod&& eas update --branch production",
    "build:aos": "set EXPO_NO_DOTENV=1&& set APP_ENV=prod&& eas build --platform android --profile production",
    "build:ios": "set EXPO_NO_DOTENV=1&& set APP_ENV=prod&& eas build --platform ios --profile production",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-kakao/core": "^2.4.6",
    "@react-native-kakao/share": "^2.4.6",
    "@react-native-kakao/social": "^2.4.6",
    "@react-native-kakao/user": "^2.4.6",
    "@tanstack/react-query": "^5.80.7",
    "async-storage": "^0.1.0",
    "axios": "^1.11.0",
    "babel-preset-expo": "~57.0.0",
    "dayjs": "^1.11.13",
    "expo": "~57.0.20",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.20",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
