    "baseline-browser-mapping": "^2.9.19",
    "env-cmd": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "react-native-svg": "15.15.4",
    "typescript": "~6.0.3"
  },
  "private": true
