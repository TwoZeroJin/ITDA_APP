{
  "expo": {
   "name": "잇다",
    "slug": "ITDA_APP",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kakao8afd31fe78bdf0bab17c4d674214c5be",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
   "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "church.hacts.itda",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "프로필 사진 및 모임, 게시글 이미지를 촬영하여 업로드하기 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "프로필 사진 및 모임, 게시글 이미지를 선택하여 업로드하기 위해 사진 접근 권한이 필요합니다.",
        "NSUserNotificationsUsageDescription": "채팅 메시지, 모임 신청 결과 및 중요한 서비스 알림을 받기 위해 알림 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "church.hacts.itda",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "8afd31fe78bdf0bab17c4d674214c5be"
        }
      ]      
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6e1d272-1b05-4170-8a86-92055f0eb5ad"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6e1d272-1b05-4170-8a86-92055f0eb5ad"
    }
  }
}